# DomoDomo Environment Configuration Template

# Firebase Configuration for Realtime Global Visitor Tracking (Realtime Database or Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Mode: 'database' (Firebase Realtime Database) or 'firestore' (Cloud Firestore)
VITE_FIREBASE_MODE=database

# Optional CounterAPI.dev User Token Fallback
VITE_COUNTER_API_KEY=
